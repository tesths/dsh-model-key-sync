{
  "name": "dsh-model-key-sync",
  "version": "1.1.0",
  "private": true,
  "description": "Sync your DeepSeek Harness model configuration and third-party API keys across machines, over S3-compatible storage or WebDAV.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cloud",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.zh.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  },
  "license": "MIT",
  "scripts": {
    "test": "node test/host.mjs && node test/client.mjs"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "model-sync",
    "api-keys",
    "webdav",
    "s3"
  ],
  "devDependencies": {
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "s3rver": "^3.7.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tesths/dsh-model-key-sync.git"
  },
  "homepage": "https://github.com/tesths/dsh-model-key-sync#readme",
  "bugs": {
    "url": "https://github.com/tesths/dsh-model-key-sync/issues"
  },
  "author": "tesths"
}
